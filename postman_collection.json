{
  "info": {
    "name": "Inventory Management API",
    "_postman_id": "6d37f2f0-42a3-4f8c-8e18-3e8a4f4b5a91",
    "description": "Requests for Assignment 3 Inventory and Data Management System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "productId",
      "value": "REPLACE_WITH_PRODUCT_ID"
    }
  ],
  "item": [
    {
      "name": "API Welcome",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/"
      }
    },
    {
      "name": "Create Product",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Gel Pen Pack of 15\",\n  \"sku\": \"STNY-PN-713\",\n  \"category\": \"Stationery\",\n  \"price\": 120,\n  \"quantity\": 40,\n  \"reorderLevel\": 20,\n  \"supplier\": \"Cello Pens\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/products"
      }
    },
    {
      "name": "Get All Products",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/products?page=1&limit=10"
      }
    },
    {
      "name": "Filter and Sort Products",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/products?category=Stationery&sort=price&order=asc&page=1&limit=5"
      }
    },
    {
      "name": "Get Single Product",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/products/{{productId}}"
      }
    },
    {
      "name": "Update Product",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"price\": 140,\n  \"quantity\": 60\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/products/{{productId}}"
      }
    },
    {
      "name": "Adjust Stock (Restock +10)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"change\": 10\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/products/{{productId}}/stock"
      }
    },
    {
      "name": "Low Stock Report",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/products/low-stock"
      }
    },
    {
      "name": "Category Summary",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/products/summary"
      }
    },
    {
      "name": "Delete Product",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/products/{{productId}}"
      }
    }
  ]
}